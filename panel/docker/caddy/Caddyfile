# Edge reverse proxy for WebinoServerManager panel (Architecture §13: only `web` publishes).
# Laravel module routes accept both /api/v1/* and /v1/* — proxy /api as-is to backend.
{
	servers {
		protocols h1 h2 h3
	}
}

:80 {
	encode zstd gzip

	handle /api* {
		reverse_proxy backend:8080
	}

	handle /embed/* {
		reverse_proxy frontend:3000
	}

	handle {
		reverse_proxy frontend:3000
	}
}
