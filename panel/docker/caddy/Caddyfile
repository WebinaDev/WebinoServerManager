# Edge reverse proxy for WebinoServerManager panel (Architecture §13: only `web` publishes).
# Module routes live at /v1/* on the PHP app. Browsers call /api/v1/* — strip /api like Next rewrites.
{
	servers {
		protocols h1 h2 h3
	}
}

:80 {
	encode zstd gzip

	handle_path /api/* {
		reverse_proxy backend:8080
	}

	handle /embed/* {
		reverse_proxy frontend:3000
	}

	handle {
		reverse_proxy frontend:3000
	}
}
