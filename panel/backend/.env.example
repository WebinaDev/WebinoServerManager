APP_NAME=WebinoServer
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:2090

APP_LOCALE=fa
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=panel-db
DB_PORT=3306
DB_DATABASE=webinoserver
DB_USERNAME=webinoserver
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set false for HTTP installs (panel.sh does this automatically). Use true behind HTTPS.
SESSION_SECURE_COOKIE=false
AUTH_COOKIE_SECURE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=panel-redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=panel@localhost
MAIL_FROM_NAME="${APP_NAME}"

FRONTEND_URL=http://localhost:2090

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:2090,127.0.0.1,127.0.0.1:2090

AUTH_COOKIE_NAME=webino_auth_token
AUTH_COOKIE_MAX_MINUTES=10080

WEBINO_SERVER_ROOT=/opt/WebinoServer
WEBINO_AGENT_SOCKET=/run/webino-agent.sock
# Required for panel-api ↔ agent and embed tickets. panel.sh generates this on install.
WEBINO_AGENT_TOKEN=
# Agent only: set WEBINO_AGENT_ALLOW_UNAUTH=true for local dev without a token (never in production).
WEBINO_BACKUP_DIR=/var/backups/webino

WEBINO_MYSQL_HOST=host.docker.internal
WEBINO_PGSQL_HOST=host.docker.internal
WEBINO_IMAP_HOST=host.docker.internal:143
WEBINO_SMTP_HOST=host.docker.internal:587
WEBINO_PHPMYADMIN_URL=
WEBINO_PHPPGADMIN_URL=
WEBINO_ROUNDCUBE_URL=
WEBINO_EMBED_TICKET_TTL=60

CORS_ALLOWED_ORIGINS=http://localhost:2090,http://127.0.0.1:2090
