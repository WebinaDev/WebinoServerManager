# Docker Compose env for panel stack — copied to panel/.env on first install.
# Secrets are generated by ./install.sh --panel or scripts/install/panel.sh.

PANEL_DB_PASSWORD=
PANEL_DB_ROOT_PASSWORD=
WEBINO_AGENT_TOKEN=
ROUNDCUBE_DES_KEY=
PANEL_HTTP_PORT=2090
PANEL_DOCS_PORT=2091

# Optional — override when Docker Hub is blocked (auto-mirror usually fixes this):
# PANEL_MARIADB_IMAGE=mirror.gcr.io/library/mariadb:11
# PANEL_REDIS_IMAGE=mirror.gcr.io/library/redis:7-alpine
# PANEL_PHPMYADMIN_IMAGE=mirror.gcr.io/library/phpmyadmin:5-apache
# PANEL_PHPPGADMIN_IMAGE=dockage/phppgadmin:latest
# PANEL_ROUNDCUBE_IMAGE=roundcube/roundcubemail:1.6.9-apache
