# Generated by ./install.sh --panel — do not copy manually; run install first.
#
# Docker production (panel-web container) — matches docker-compose.panel.yml:
#   INTERNAL_API_URL=http://panel-api:8080
#   API_PROXY_TARGET=http://panel-api:8080
#
# Local npm run dev (API on host): use http://127.0.0.1:8080 or your artisan serve port.

# Public API base URL (empty = same-origin via rewrite/proxy)
NEXT_PUBLIC_API_URL=

# Server-side API URL for middleware
INTERNAL_API_URL=http://panel-api:8080

# Auth cookie name (must match backend AUTH_COOKIE_NAME)
AUTH_COOKIE_NAME=webino_auth_token

# Dev proxy target for next.config rewrites
API_PROXY_TARGET=http://panel-api:8080
